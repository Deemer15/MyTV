# your own TV's dumps (serial, android_id, device names) stay local
backup/
# session screenshots and working notes (may show the Wi-Fi name or account avatar) stay local
shots/
work/
# Perfetto traces from tools/trace.py: large, and they hold the TV's process list
traces/
# Results from tools/bench.py: result.json carries the address the run was given and the TV's fingerprint.
bench-results/
.DS_Store

# Generated install bundles and JVM crash reports stay out of contributions.
*.apk
*.aab
launcher/hs_err_pid*.log
launcher/replay_pid*.log
# IPTV rail login (Xtream Codes) stays local
launcher/app/src/main/res/values/iptv_secrets.xml
# Beast rail server addresses + API key stays local
launcher/app/src/main/res/values/beast_secrets.xml
# TMDB api key for the Streaming section stays local
launcher/app/src/main/res/values/tmdb_secrets.xml
# Per-room TV snapshots (serials, device names) stay local
mytv/*/backups/
.venv/
# Mediarium read-only API key for the Beast page stays local
mytv/*/beast_key.txt
# Per-room working folder (device notes, keys) stays local in this private fork
mytv/
# Kiro session export and editor workspace scratch
kiro-session-*.zip
cleanyourtv.code-workspace
.agents/
# Local agent conventions / steering (holds a LAN IP and work-email reference) — stays local
.kiro/
